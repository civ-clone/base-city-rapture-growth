    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-city-growth-limit": "^0.1.0",
